# Signs session cookies. Required in production; a development fallback is used locally.
SESSION_SECRET=

# The origin baked into prerendered pages at BUILD time: canonical links, hreflang alternates,
# sitemap entries and og:image URLs. Unset, it falls back to http://localhost:5173, so a
# production build without it ships a site whose every canonical URL points at localhost.
# Set this in the Vercel project (production) to the deployment's own URL.
PUBLIC_SITE_URL=
